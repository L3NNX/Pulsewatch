# ── Production Environment Variables ──
# Copy this file to .env.production and fill in real values

# Frontend URL (your Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app

# PostgreSQL credentials
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Security secrets (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
